# Copy this file to .env and fill in real values. .env is gitignored.

# MySQL connection, matches docker-compose.yml
# Port 3307 on the host maps to 3306 in the container, since 3306 is a
# common default for a locally installed MySQL server and this avoids
# clashing with one. Change both this value and the port mapping in
# docker-compose.yml together if you need a different port.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=flight_dw
MYSQL_USER=flight_dw_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Data year for the ETL run. Resolved to 2025 on 2026-11-17 with real
# verification against the BTS TranStats site; see docs/DECISIONS.md,
# decision 1.
DATA_YEAR=2025
